/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Since @astrojs/cloudflare v14 this file only needs to declare *custom*
 * settings. The adapter (via @cloudflare/vite-plugin) resolves `main` and
 * `assets.directory` itself and writes a deploy-ready config to
 * `dist/client/wrangler.json`, which Wrangler picks up automatically through
 * the redirect in `.wrangler/deploy/config.json`.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "davidtofan-astro",
	// Pinned to the compatibility date implemented by the installed workerd
	// (node_modules/workerd -> 1.20260826.1), so `wrangler dev` locally and the
	// deployed Worker agree on runtime behavior. Bump this alongside Wrangler:
	// `npm run deps:check` reports the newest date the installed runtime supports.
	"compatibility_date": "2026-08-26",
	"compatibility_flags": [
		// Redundant for compatibility dates >= 2026-08-04 (Workers enables
		// nodejs_compat + nodejs_compat_v2 by default from that date; the tooling
		// ignores the flag). Kept so Node APIs stay on if the date is ever lowered.
		"nodejs_compat",
		// Has no "default as of" date - it only ever applies when set explicitly.
		// Routes global fetch() as if from the public Internet.
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
		/**
		 * COMMENTED OUT ON PURPOSE — uncomment together with
		 * GEO_PERSONALIZATION: "TRUE" above. The build fails with instructions
		 * if you change one without the other.
		 *
		 * Workers Static Assets is asset-first by design, and this site relies
		 * on that: with the flag off every route is a static file and nothing is
		 * billed. `run_worker_first` is the documented opt-out of asset-first
		 * routing, so it belongs here only while `/` actually needs a Worker.
		 *
		 * Why it is required in that case: since compatibility_date 2025-04-01
		 * the `assets_navigation_prefers_asset_serving` flag is on by default, so
		 * a request carrying `Sec-Fetch-Mode: navigate` prefers asset serving and
		 * falls back to `404.html` *before* the Worker is invoked. With `/`
		 * on-demand there is no `index.html` to serve, so a hard refresh on the
		 * homepage returns the 404 page while `curl` succeeds — a failure that
		 * only shows up in a browser.
		 *
		 * Scoping it to exactly `/` leaves every other route asset-first.
		 * https://developers.cloudflare.com/workers/static-assets/routing/worker-script/
		 */
		// "run_worker_first": ["/"]
	},
	// Astro Sessions are backed by Cloudflare KV via the SESSION binding (the
	// @astrojs/cloudflare adapter enables this automatically). Pin the existing
	// namespace id so deploys reuse it instead of trying to re-create it, which
	// fails with "a namespace with this title already exists" [code: 10014].
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "3198ea8b77fb4040974377ab70d9b93c"
		}
	],
	/**
	 * Feature flag for geolocation-based personalization.
	 *
	 * "FALSE" (the default) -> `/` is prerendered. Zero Worker invocations; the
	 *            site deploys as assets-only, so every request is a free static
	 *            asset request. The localized routes, the language picker and the
	 *            hreflang graph all keep working — they are static files too.
	 * "TRUE"  -> `/` renders on demand: detects country + language, offers a
	 *            language switch. Costs a billed Worker invocation on EVERY
	 *            homepage view, and on the free plan a spike past the daily limit
	 *            returns 429 on `/` rather than falling back to the static page.
	 *
	 * Read at BUILD time by astro.config.mjs, because `prerender` is decided when
	 * the site is built. Changing it in the dashboard alone will not take effect;
	 * change it here and redeploy.
	 */
	"vars": {
		"GEO_PERSONALIZATION": "FALSE"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "davidtofan.com",
			"custom_domain": true
		}
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
