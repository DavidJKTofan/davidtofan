/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Since @astrojs/cloudflare v14 this file only needs to declare *custom*
 * settings. The adapter (via @cloudflare/vite-plugin) resolves `main` and
 * `assets.directory` itself and writes a deploy-ready config to
 * `dist/client/wrangler.json`, which Wrangler picks up automatically through
 * the redirect in `.wrangler/deploy/config.json`.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "davidtofan-astro",
	// Pinned to the compatibility date implemented by the installed workerd
	// (node_modules/workerd -> 1.20260826.1), so `wrangler dev` locally and the
	// deployed Worker agree on runtime behavior. Bump this alongside Wrangler:
	// `npm run deps:check` reports the newest date the installed runtime supports.
	"compatibility_date": "2026-08-26",
	"compatibility_flags": [
		// Redundant for compatibility dates >= 2026-08-04 (Workers enables
		// nodejs_compat + nodejs_compat_v2 by default from that date; the tooling
		// ignores the flag). Kept so Node APIs stay on if the date is ever lowered.
		"nodejs_compat",
		// Has no "default as of" date - it only ever applies when set explicitly.
		// Routes global fetch() as if from the public Internet.
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	// Astro Sessions are backed by Cloudflare KV via the SESSION binding (the
	// @astrojs/cloudflare adapter enables this automatically). Pin the existing
	// namespace id so deploys reuse it instead of trying to re-create it, which
	// fails with "a namespace with this title already exists" [code: 10014].
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "3198ea8b77fb4040974377ab70d9b93c"
		}
	],
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "davidtofan.com",
			"custom_domain": true
		}
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
