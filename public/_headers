# Custom headers for static assets
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Note: All pages are prerendered as static HTML, so all headers are set here.
#
# Early Hints: Cloudflare automatically caches and sends 103 Early Hints
# based on Link headers in origin responses. Enable in Cloudflare Dashboard:
# Speed > Optimization > Content Optimization > Early Hints
# https://developers.cloudflare.com/cache/advanced-configuration/early-hints/

# AI agent discovery — RFC 8288 Link headers
# rel="describedby" / "license" per RFC 9727 §3 + Cloudflare ai-crawl-control guide.
# /ai-licensing-terms/ is the real target page (src/pages/ai-licensing-terms.astro).

# Security + agent-discovery headers for all HTML pages
/*.html
  Link: </ai-licensing-terms/>; rel="describedby"; type="text/html", </ai-licensing-terms/>; rel="license"; type="text/html", </rsl.xml>; rel="license"; type="application/rsl+xml", </sitemap-index.xml>; rel="sitemap"
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

/
  Link: </ai-licensing-terms/>; rel="describedby"; type="text/html", </ai-licensing-terms/>; rel="license"; type="text/html", </rsl.xml>; rel="license"; type="application/rsl+xml", </sitemap-index.xml>; rel="sitemap"
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

/articles/*
  Link: </ai-licensing-terms/>; rel="describedby"; type="text/html", </ai-licensing-terms/>; rel="license"; type="text/html", </rsl.xml>; rel="license"; type="application/rsl+xml", </sitemap-index.xml>; rel="sitemap"
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

/projects/*
  Link: </ai-licensing-terms/>; rel="describedby"; type="text/html", </ai-licensing-terms/>; rel="license"; type="text/html", </rsl.xml>; rel="license"; type="application/rsl+xml", </sitemap-index.xml>; rel="sitemap"
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

/certificates/
  Link: </ai-licensing-terms/>; rel="describedby"; type="text/html", </ai-licensing-terms/>; rel="license"; type="text/html", </rsl.xml>; rel="license"; type="application/rsl+xml", </sitemap-index.xml>; rel="sitemap"
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

/ai-licensing-terms/
  Link: </ai-licensing-terms/>; rel="describedby"; type="text/html", </ai-licensing-terms/>; rel="license"; type="text/html", </rsl.xml>; rel="license"; type="application/rsl+xml", </sitemap-index.xml>; rel="sitemap"
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex

# Preview protection: _headers supports absolute-URL (host) matching, e.g.
#   https://<worker>.<account-subdomain>.workers.dev/*
#     X-Robots-Tag: noindex
# Not enabled here because it cannot be verified locally — `wrangler dev` does not
# do production-faithful host matching (a literal host rule matches every host,
# including localhost), and a rule that over-matched would apply `noindex` to
# davidtofan.com. Prefer `"workers_dev": false` in wrangler.jsonc, which removes
# the preview URL entirely; or add the rule with the exact literal host.
# https://developers.cloudflare.com/workers/static-assets/headers/

/welcome
  X-Robots-Tag: noindex
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# robots.txt — force UTF-8 so Content Signals render correctly (em dashes etc.)
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=36000

# RSL 1.0 machine-readable license document — https://rslstandard.org/rsl
/rsl.xml
  # Use a browser-native XML media type so the document renders instead of downloading.
  Content-Type: application/xml; charset=utf-8
  Content-Disposition: inline
  Cache-Control: public, max-age=36000
  X-Content-Type-Options: nosniff

# NOTE: /cdn-cgi/* is reserved and served by Cloudflare (image transformations,
# trace, challenge platform). It never reaches static-asset routing, so it cannot
# and must not be targeted by rules here.
# https://developers.cloudflare.com/fundamentals/reference/cdn-cgi-endpoint/
#
# Content-Type is intentionally NOT set below: Wrangler determines the MIME type
# from each file's extension at upload time. Declaring it again also mislabelled
# 404 responses on missing paths.
#
# Astro optimized/fingerprinted assets (hashed filenames) - cache for 1 year
# These files have content hashes in their names, so they can be cached indefinitely.
# Content-Type is attached automatically by Wrangler from the file extension.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Static assets at the ROOT level only (favicons, manifest, etc.) - cache for 10 hours
#
# These use a `:file` placeholder rather than a `*` splat on purpose. A splat greedily
# matches across `/`, so `/*.png` also matched `/_astro/<name>.<hash>.png` and
# `/img/<dir>/<name>.png`. Every rule that matches is applied and duplicate headers are
# joined with commas, which produced conflicting values such as:
#   Cache-Control: public, max-age=31536000, immutable, public, max-age=36000
#   Content-Type: image/webp, image/webp, image/webp
# A placeholder matches everything except `/`, so these stay at the root.
# https://developers.cloudflare.com/workers/static-assets/headers/
/:file.png
  Cache-Control: public, max-age=36000
  X-Content-Type-Options: nosniff

/:file.jpg
  Cache-Control: public, max-age=36000
  X-Content-Type-Options: nosniff

/:file.jpeg
  Cache-Control: public, max-age=36000
  X-Content-Type-Options: nosniff

/:file.svg
  Cache-Control: public, max-age=36000
  X-Content-Type-Options: nosniff

/:file.ico
  # Override: Wrangler infers the IANA-registered image/vnd.microsoft.icon;
  # image/x-icon is the long-standing de-facto type with the widest support.
  Content-Type: image/x-icon
  Cache-Control: public, max-age=36000
  X-Content-Type-Options: nosniff

/:file.webp
  Cache-Control: public, max-age=36000
  X-Content-Type-Options: nosniff

# Web manifest
/:file.webmanifest
  Cache-Control: public, max-age=36000
  X-Content-Type-Options: nosniff

# Web fonts (if added in future) - cache for 1 year.
# Fingerprinted fonts emitted under /_astro/ are already covered by the rule above.
/:file.woff
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/:file.woff2
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Images in content subdirectories.
# X-Content-Type-Options is already applied to everything under these paths by the
# /articles/* and /projects/* rules above, so it is deliberately not repeated here.
/articles/:slug/*.png
  Cache-Control: public, max-age=36000

/projects/:slug/*.png
  Cache-Control: public, max-age=36000

# Images under /img/<dir>/<file>. A splat matches across `/`, so one rule per
# extension covers every depth - no separate `:dir` rule (which would double up).
/img/*.png
  Cache-Control: public, max-age=36000
  X-Content-Type-Options: nosniff

/img/*.jpg
  Cache-Control: public, max-age=36000
  X-Content-Type-Options: nosniff

/img/*.jpeg
  Cache-Control: public, max-age=36000
  X-Content-Type-Options: nosniff

/img/*.webp
  Cache-Control: public, max-age=36000
  X-Content-Type-Options: nosniff
