---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Home from '../components/pages/Home.astro';
import { resolvePreferredLang, isLang } from '../i18n/utils';
import { resolveRegion, REGION_COOKIE, LANG_COOKIE, OFFER_COOKIE, PREF_COOKIE_MAX_AGE } from '../i18n/regions';
import { defaultLang } from '../i18n/ui';

/**
 * The only on-demand route on the site.
 *
 * Everything else stays prerendered and is served straight from Workers static
 * assets without invoking this Worker at all. This page is the one place where
 * `request.cf` is available, so it is where the visitor's country is resolved
 * and written to a cookie that the prerendered pages can then read client-side.
 */
/*
 * Literal `true` on purpose, and flipped to `false` by the
 * `geo-personalization-flag` integration in astro.config.mjs when
 * GEO_PERSONALIZATION is enabled.
 *
 * It cannot be an expression: Astro reads this export with a regex over the
 * raw file — /^\s*export\s+const\s+prerender\s*=\s*(true|false);?/m — so
 * anything that is not a bare `true` or `false` is silently ignored and the
 * route falls back to the default. The `astro:route:setup` hook is the
 * supported way to decide this at build time.
 */
export const prerender = true;

/*
 * When GEO_PERSONALIZATION is off this whole block is skipped and the page is
 * prerendered: no request.cf to read, no cookies to set, and no response
 * headers to mutate — all three are on-demand-only APIs. `__GEO_PERSONALIZATION__`
 * is substituted as a literal at build time, so the dead branch is eliminated
 * from the bundle rather than merely skipped at runtime.
 */
const geoEnabled = __GEO_PERSONALIZATION__;

// Cloudflare attaches geolocation to the request itself. As of @astrojs/cloudflare
// v13 this is read from the request rather than Astro.locals.runtime.
const country = geoEnabled
  ? ((Astro.request as Request & { cf?: { country?: string } }).cf?.country ?? null)
  : null;

const storedLang = geoEnabled ? Astro.cookies.get(LANG_COOKIE)?.value : undefined;
const offerState = geoEnabled ? Astro.cookies.get(OFFER_COOKIE)?.value : undefined;
const storedRegion = geoEnabled ? Astro.cookies.get(REGION_COOKIE)?.value : undefined;

/*
 * A stored language is the marker that the visitor has chosen for themselves,
 * and the picker writes the matching region alongside it. So once a choice
 * exists, geolocation must not overwrite it — otherwise someone in Spain who
 * deliberately picked English would have the neutral palette they asked for
 * replaced by Spain's on their next visit to `/`.
 *
 * With no stated preference, the country decides and is refreshed each visit.
 */
const hasExplicitChoice = isLang(storedLang);
const region = hasExplicitChoice ? resolveRegion(storedRegion) : resolveRegion(country);

// A stored preference is an explicit past choice, so honour it. This is not a
// geo-redirect: country alone never triggers it.
if (isLang(storedLang) && storedLang !== defaultLang) {
  return Astro.redirect(getRelativeLocaleUrl(storedLang, ''), 302);
}

// Browser language leads; country is only consulted when the header says nothing.
const preferred = geoEnabled
  ? resolvePreferredLang(
      Astro.preferredLocale,
      Astro.request.headers.get('accept-language'),
      country,
    )
  : defaultLang;

// Offer the switch rather than performing it. Suppressed once the visitor has
// answered either way, so we ask at most once.
const offerLang = preferred !== defaultLang && !offerState ? preferred : null;

// Hand the region to BaseLayout so <html data-region> is correct in the first
// byte of HTML, rather than being corrected by the inline script after paint.
Astro.locals.detectedRegion = region;

// Remember the country so the prerendered pages can style themselves without
// another Worker invocation. Country code and language tag only.
// Skipped when the visitor has made an explicit choice — that cookie is theirs.
if (geoEnabled && region && !hasExplicitChoice) {
  Astro.cookies.set(REGION_COOKIE, region, {
    path: '/',
    maxAge: PREF_COOKIE_MAX_AGE,
    sameSite: 'lax',
    httpOnly: false,
  });
}

// public/_headers only applies to static assets, and this route is no longer
// one. Re-apply what the `/` block there was providing, plus the caching rules
// this page needs now that it varies per visitor.
// Only an on-demand response has headers to set; on a prerendered page these
// come from public/_headers like every other static route.
const headers = geoEnabled ? Astro.response.headers : new Headers();
headers.set(
  'Link',
  '</ai-licensing-terms/>; rel="describedby"; type="text/html", ' +
    '</ai-licensing-terms/>; rel="license"; type="text/html", ' +
    '</rsl.xml>; rel="license"; type="application/rsl+xml", ' +
    '</sitemap-index.xml>; rel="sitemap"',
);
headers.set('X-Content-Type-Options', 'nosniff');
headers.set('X-Frame-Options', 'SAMEORIGIN');
headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');
/*
 * `no-store` would be the obvious choice for a per-visitor page, but Chrome
 * treats it as a hard blocker for the back/forward cache, so every "back" to
 * the homepage would pay a full round trip. `private, no-cache` keeps the
 * response out of shared caches and revalidates before reuse, while leaving
 * the page bfcache-eligible — which is what the Core Web Vitals actually
 * measure on back navigation.
 */
headers.set('Cache-Control', 'private, no-cache, must-revalidate');
headers.set('Vary', 'Accept-Language, Cookie');
// The asset server sends a charset on static pages; an on-demand response has
// to declare its own, or a locale offer in Chinese can mis-render before the
// <meta charset> is parsed.
headers.set('Content-Type', 'text/html; charset=utf-8');
---

<Home offerLang={offerLang} />
