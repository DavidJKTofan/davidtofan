---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../i18n/ui';
import { localeFrom, useTranslations, LANGS, HTML_LANG } from '../i18n/utils';

const lang = localeFrom(Astro.currentLocale);
const t = useTranslations(lang);

/**
 * Only the five landing routes exist in every locale. From anywhere else
 * (an article, a legal page) the picker points at that locale's home, because
 * linking to a localized URL that was never built would 404.
 */
const LOCALIZED_ROUTES = new Set(['/', '/articles/', '/projects/', '/certificates/']);

const stripped = '/' + Astro.url.pathname
  .split('/')
  .filter(Boolean)
  .filter((segment, index) => !(index === 0 && LANGS.includes(segment as Lang)))
  .join('/');
const basePath = stripped === '/' ? '/' : `${stripped.replace(/\/$/, '')}/`;
const isLocalizedRoute = LOCALIZED_ROUTES.has(basePath);
const target = isLocalizedRoute ? basePath : '/';

const options = LANGS.map((code) => ({
  code,
  label: languages[code],
  // getRelativeLocaleUrl honours prefixDefaultLocale, so English stays unprefixed.
  href: getRelativeLocaleUrl(code, target === '/' ? '' : target),
  current: code === lang,
}));
---

{/*
  Disclosure pattern (WAI-ARIA APG "Disclosure Navigation Menu"), not an ARIA
  menu: a button with aria-expanded/aria-controls that shows a plain list of
  links. role="menu" promises arrow-key and typeahead behaviour that a short
  list of navigation links neither has nor needs.
*/}
<div class="relative" id="language-picker">
  <button
    id="language-picker-toggle"
    type="button"
    class="inline-flex h-11 w-11 cursor-pointer select-none items-center justify-center rounded-lg text-surface-500 dark:text-surface-400 hover:text-surface-700 dark:hover:text-surface-200 hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors duration-200"
    aria-label={t('a11y.selectLanguage')}
    title={t('a11y.selectLanguage')}
    aria-expanded="false"
    aria-controls="language-picker-menu"
  >
    <svg
      class="pointer-events-none block w-5 h-5"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z" />
    </svg>
  </button>

  {/*
    Opaque on purpose. This panel sits inside the header's .glass element,
    whose backdrop-filter makes the header the backdrop root, so a
    backdrop-blur here had nothing to blur and the page showed straight through
    the menu items.
  */}
  <ul
    id="language-picker-menu"
    class="hidden absolute right-0 top-full mt-2 min-w-40 rounded-xl border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-900 shadow-lg shadow-surface-900/10 dark:shadow-black/40 p-1 z-50"
  >
    {options.map((option) => (
      <li>
        <a
          href={option.href}
          {/* Same BCP-47 tag the <link rel="alternate"> graph uses, so the two
              never disagree (zh-Hans, not a bare zh). */}
          hreflang={HTML_LANG[option.code]}
          lang={HTML_LANG[option.code]}
          data-lang={option.code}
          aria-current={option.current ? (isLocalizedRoute ? 'page' : 'true') : undefined}
          class:list={[
            'flex cursor-pointer select-none items-center justify-between gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors duration-200',
            option.current
              ? 'text-accent-600 dark:text-accent-400 bg-accent-50 dark:bg-accent-900/20'
              : 'text-surface-600 dark:text-surface-400 hover:text-surface-900 dark:hover:text-surface-100 hover:bg-surface-100 dark:hover:bg-surface-800',
          ]}
        >
          <span class="pointer-events-none">{option.label}</span>
          {option.current && (
            <svg class="pointer-events-none w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M20 6L9 17l-5-5" />
            </svg>
          )}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  /*
   * A processed (bundled, cacheable) module rather than a define:vars inline
   * script: the shared preference logic and its constants come from
   * src/i18n/client.ts instead of being serialized into every page.
   *
   * Follows the same binding contract as the mobile menu in Header.astro:
   * an AbortController-scoped set of listeners, a dataset guard so repeated
   * setup calls are cheap, and a re-bind on astro:page-load. Without the
   * re-bind the picker silently stops working after the first client-side
   * navigation, because <ClientRouter /> swaps the whole document.
   */
  import { rememberLanguageChoice } from '../i18n/client';

  function setupLanguagePicker() {
    const picker = document.getElementById('language-picker');
    const toggle = document.getElementById('language-picker-toggle');
    const menu = document.getElementById('language-picker-menu');

    if (!(picker instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
    if (toggle.dataset.languagePickerBound === 'true') return;

    const appWindow = window as Window & { languagePickerAbortController?: AbortController };
    appWindow.languagePickerAbortController?.abort();
    const controller = new AbortController();
    appWindow.languagePickerAbortController = controller;
    const { signal } = controller;

    toggle.dataset.languagePickerBound = 'true';

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    function closeMenu() {
      toggle.setAttribute('aria-expanded', 'false');
      menu.classList.add('hidden');
    }

    function openMenu() {
      toggle.setAttribute('aria-expanded', 'true');
      menu.classList.remove('hidden');
    }

    toggle.addEventListener('click', () => (isOpen() ? closeMenu() : openMenu()), { signal });

    // Escape closes and returns focus to the button (APG disclosure pattern).
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && isOpen()) {
          closeMenu();
          toggle.focus();
        }
      },
      { signal },
    );

    // Close when keyboard focus leaves the widget, so a tabbed-past panel does
    // not stay open over the page.
    picker.addEventListener(
      'focusout',
      (event) => {
        const next = event.relatedTarget;
        if (isOpen() && next instanceof Node && !picker.contains(next)) closeMenu();
      },
      { signal },
    );

    document.addEventListener(
      'click',
      (event) => {
        if (!isOpen() || !(event.target instanceof Node)) return;
        if (picker.contains(event.target)) return;
        closeMenu();
      },
      { signal },
    );

    // Persist the choice so the on-demand `/` honours it on the next cold
    // visit instead of re-deciding from Accept-Language every time. The <a>
    // still navigates normally, so this works with JS disabled too.
    menu.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((link) => {
      link.addEventListener(
        'click',
        () => {
          const chosen = link.dataset.lang;
          if (!chosen) return;

          const nextRegion = rememberLanguageChoice(chosen);

          // Apply immediately so the new palette is visible on this page rather
          // than only after the navigation lands. The one-frame transition
          // suppression avoids Chromium stranding var()-derived colours
          // mid-interpolation (see .region-swapping in global.css).
          const root = document.documentElement;
          root.classList.add('region-swapping');
          if (nextRegion) root.setAttribute('data-region', nextRegion);
          else root.removeAttribute('data-region');
          void root.offsetHeight;
          root.classList.remove('region-swapping');

          closeMenu();
        },
        { signal },
      );
    });
  }

  function initLanguagePicker() {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupLanguagePicker, { once: true });
    } else {
      setupLanguagePicker();
    }
  }

  // A bundled module runs once per full page load, so this listener is only
  // ever added once; no dataset guard is needed for it.
  document.addEventListener('astro:page-load', setupLanguagePicker);
  initLanguagePicker();
</script>
