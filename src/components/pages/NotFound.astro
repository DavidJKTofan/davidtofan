---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import logo from '../../assets/img/logo.svg';
import { localeFrom, useTranslations, LANGS, HTML_LANG } from '../../i18n/utils';
import { LANG_COOKIE } from '../../i18n/regions';

const lang = localeFrom(Astro.currentLocale);
const t = useTranslations(lang);

/*
 * The 404 is the one page that cannot be a localized *route*. Astro emits the
 * root 404.astro as `404.html` (a real error page), but a nested `es/404.astro`
 * emits `es/404/index.html` — an ordinary page that Cloudflare's
 * `not_found_handling: "404-page"` would never serve, because it looks for the
 * nearest `404.html`. Localized 404 routes would therefore be dead files while
 * /es/anything still rendered English.
 *
 * So this page ships every translation inline and picks one on the client from
 * the stored preference. That is safe precisely here: an error page is never
 * indexed, so there is no SEO cost and no canonical to get wrong.
 */
const NOT_FOUND_STRINGS = Object.fromEntries(
  LANGS.map((code) => {
    const tr = useTranslations(code);
    return [code, {
      title: tr('notfound.title'),
      sub: tr('notfound.sub'),
      goHome: tr('notfound.goHome'),
      back: tr('notfound.back'),
      suggest: tr('notfound.suggest'),
      articles: tr('nav.articles'),
      projects: tr('nav.projects'),
      certificates: tr('nav.certificates'),
    }];
  }),
);

---


<BaseLayout
  title={t('notfound.title')}
  description="The page you're looking for doesn't exist or has been moved."
  noIndex={true}
>
  <div class="min-h-[70vh] flex items-center justify-center px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full text-center">
      <!-- Logo -->
      <div class="mb-8 flex justify-center">
        <div class="relative">
          <div class="absolute inset-0 blur-2xl bg-accent-500/20 dark:bg-accent-400/10 rounded-full scale-150"></div>
          <Image
            src={logo}
            alt="David Tofan"
            width={80}
            height={80}
            class="relative w-20 h-20 opacity-60 dark:opacity-40"
          />
        </div>
      </div>

      <!-- 404 Number -->
      <div class="relative mb-6">
        <span class="text-[10rem] sm:text-[12rem] font-display font-bold leading-none text-surface-100 dark:text-surface-900 select-none">
          404
        </span>
        <span class="absolute inset-0 flex items-center justify-center text-[10rem] sm:text-[12rem] font-display font-bold leading-none bg-gradient-to-br from-accent-500 to-accent-600 bg-clip-text text-transparent opacity-80">
          404
        </span>
      </div>

      <!-- Message -->
      <h1 class="font-display font-bold text-2xl sm:text-3xl text-surface-900 dark:text-surface-100 mb-3">
        <span data-nf="title">{t('notfound.title')}</span>
      </h1>
      <p class="text-surface-600 dark:text-surface-400 mb-8 text-lg">
        <span data-nf="sub">{t('notfound.sub')}</span>
      </p>

      <!-- Actions -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/" class="btn-primary w-full sm:w-auto">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span data-nf="goHome">{t('notfound.goHome')}</span>
        </a>
        <button
          onclick="history.back()"
          class="btn-secondary w-full sm:w-auto"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span data-nf="back">{t('notfound.back')}</span>
        </button>
      </div>

      <!-- Helpful Links -->
      <div class="mt-12 pt-8 border-t border-surface-200 dark:border-surface-800">
        <p class="text-sm text-surface-500 dark:text-surface-500 mb-4">
          <span data-nf="suggest">{t('notfound.suggest')}</span>
        </p>
        <div class="flex flex-wrap justify-center gap-4 text-sm">
          <a href="/articles/" data-nf-link="articles" class="text-accent-600 dark:text-accent-400 hover:underline">
            <span data-nf="articles">{t('nav.articles')}</span>
          </a>
          <a href="/projects/" data-nf-link="projects" class="text-accent-600 dark:text-accent-400 hover:underline">
            <span data-nf="projects">{t('nav.projects')}</span>
          </a>
          <a href="/certificates/" data-nf-link="certificates" class="text-accent-600 dark:text-accent-400 hover:underline">
            <span data-nf="certificates">{t('nav.certificates')}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ NOT_FOUND_STRINGS, HTML_LANG, LANG_COOKIE }}>
  (function () {
    function readCookie(name) {
      var m = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
      return m ? decodeURIComponent(m[1]) : null;
    }
    var chosen = null;
    try { chosen = localStorage.getItem('lang'); } catch (e) { /* private mode */ }
    if (!chosen) chosen = readCookie(LANG_COOKIE);
    if (!chosen || !NOT_FOUND_STRINGS[chosen] || chosen === 'en') return;

    var strings = NOT_FOUND_STRINGS[chosen];
    document.documentElement.lang = HTML_LANG[chosen];
    document.querySelectorAll('[data-nf]').forEach(function (el) {
      var key = el.getAttribute('data-nf');
      if (strings[key]) el.textContent = strings[key];
    });
    // Point the suggestions at the visitor's own locale.
    document.querySelectorAll('[data-nf-link]').forEach(function (el) {
      el.setAttribute('href', '/' + chosen + '/' + el.getAttribute('data-nf-link') + '/');
    });
    var home = document.querySelector('a[href="/"]');
    if (home) home.setAttribute('href', '/' + chosen + '/');
  })();
</script>
